{
  "openapi": "3.0.3",
  "info": {
    "title": "Oficina Billing Service",
    "version": "0.2.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/budgets/{id}": {
      "get": {
        "summary": "Consultar orçamento",
        "responses": {
          "200": {
            "description": "Sucesso"
          },
          "400": {
            "description": "Payload inválido"
          },
          "401": {
            "description": "Autenticação inválida"
          },
          "403": {
            "description": "Sem permissão"
          },
          "409": {
            "description": "Conflito de idempotência"
          },
          "422": {
            "description": "Regra de negócio inválida"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/budgets/{id}/decision": {
      "post": {
        "summary": "Aprovar ou recusar",
        "responses": {
          "200": {
            "description": "Sucesso"
          },
          "400": {
            "description": "Payload inválido"
          },
          "401": {
            "description": "Autenticação inválida"
          },
          "403": {
            "description": "Sem permissão"
          },
          "409": {
            "description": "Conflito de idempotência"
          },
          "422": {
            "description": "Regra de negócio inválida"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Decision"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/payments/webhook": {
      "post": {
        "summary": "Webhook Mercado Pago",
        "responses": {
          "200": {
            "description": "Sucesso"
          },
          "400": {
            "description": "Payload inválido"
          },
          "401": {
            "description": "Autenticação inválida"
          },
          "403": {
            "description": "Sem permissão"
          },
          "409": {
            "description": "Conflito de idempotência"
          },
          "422": {
            "description": "Regra de negócio inválida"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Webhook"
              }
            }
          }
        },
        "security": [],
        "parameters": [
          {
            "in": "header",
            "name": "x-signature",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-request-id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "data.id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/service-catalog/{id}": {
      "get": {
        "summary": "Consultar catálogo",
        "responses": {
          "200": {
            "description": "Sucesso"
          },
          "400": {
            "description": "Payload inválido"
          },
          "401": {
            "description": "Autenticação inválida"
          },
          "403": {
            "description": "Sem permissão"
          },
          "409": {
            "description": "Conflito de idempotência"
          },
          "422": {
            "description": "Regra de negócio inválida"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "summary": "Cadastrar/atualizar catálogo",
        "responses": {
          "200": {
            "description": "Sucesso"
          },
          "400": {
            "description": "Payload inválido"
          },
          "401": {
            "description": "Autenticação inválida"
          },
          "403": {
            "description": "Sem permissão"
          },
          "409": {
            "description": "Conflito de idempotência"
          },
          "422": {
            "description": "Regra de negócio inválida"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Catalog"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8
            }
          }
        ]
      }
    },
    "/health": {
      "get": {
        "security": [],
        "summary": "/health",
        "responses": {
          "200": {
            "description": "Operacional"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "security": [],
        "summary": "/ready",
        "responses": {
          "200": {
            "description": "Operacional"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "security": [],
        "summary": "/metrics",
        "responses": {
          "200": {
            "description": "Operacional"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Decision": {
        "type": "object",
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "APPROVED",
              "REJECTED"
            ]
          }
        }
      },
      "Webhook": {
        "type": "object",
        "required": [
          "type",
          "data"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "payment"
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        }
      },
      "Catalog": {
        "type": "object",
        "required": [
          "name",
          "unitPriceCents"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "unitPriceCents": {
            "type": "integer",
            "minimum": 1
          },
          "isActive": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  }
}
